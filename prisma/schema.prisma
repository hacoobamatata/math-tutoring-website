// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

model AppUser {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique
  role        UserRole @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentProfile    StudentProfile?
  studentSessions   TutoringSession[]  @relation("StudentSessions")
  createdSessions   TutoringSession[]  @relation("CreatedSessions")
  availabilitySlots AvailabilitySlot[] @relation("AvailabilitySlotCreator")
}

model StudentProfile {
  userId        String   @id @db.Uuid
  preferredName String
  gradeLevel    Int?
  timeZone      String
  goals         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TutoringSession {
  id                 String   @id @default(uuid()) @db.Uuid
  studentId          String   @db.Uuid
  createdById        String   @db.Uuid
  availabilitySlotId String?  @unique @db.Uuid
  startsAt           DateTime
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student          AppUser           @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Restrict)
  createdBy        AppUser           @relation("CreatedSessions", fields: [createdById], references: [id], onDelete: Restrict)
  availabilitySlot AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id], onDelete: SetNull)

  @@index([studentId, startsAt])
  @@index([createdById, startsAt])
}

model AvailabilitySlot {
  id          String   @id @default(uuid()) @db.Uuid
  createdById String   @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy AppUser          @relation("AvailabilitySlotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  booking   TutoringSession?

  @@index([createdById, startsAt])
  @@index([startsAt])
}

model TestRecord {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}
